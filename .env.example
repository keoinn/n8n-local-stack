# =============================================================================
# 部署場景與對外通道
# =============================================================================
# A：空白本機 Postgres
# B：複製 Cloud Run 資料到本機 Postgres
# C：直連遠端 Supabase
N8N_SCENARIO=A

# true：對外 Webhook / OAuth；false：僅本機編輯
ENABLE_NGROK=false

# =============================================================================
# 必填區（場景 A / B 要本機 Postgres；場景 C 可略過密碼）
# =============================================================================
# 不要填雲端資料庫帳密。
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# ENABLE_NGROK=true 時必填。網域只要主機名，不要加 https://
NGROK_AUTHTOKEN=YOUR_NGROK_AUTHTOKEN
NGROK_DOMAIN=YOUR_NGROK_DOMAIN

# 通常不用改
N8N_IMAGE=n8nio/n8n:2.36.8
# Code 節點允許 require 的外部套件（逗號分隔）。官方映像不含這些套件，啟動時會建置本機映像並安裝。
# 改過套件清單後，請再執行一次啟動腳本（會重建 n8n 映像）。
NODE_FUNCTION_ALLOW_EXTERNAL=pdf-lib
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Taipei

# =============================================================================
# 場景 A 必填區（以新的環境開始）
# =============================================================================
# 沒有額外必填。不必填 encryption key 與 CLOUD_DB_*，也不需要 gcloud。

# =============================================================================
# 場景 B 必填區（繼承 Google Cloud Run 的資料到本機 Postgres）
# =============================================================================
# 先 gcloud auth login，再執行 pull-secrets。請勿手填密鑰區。
GCP_PROJECT=YOUR_GCP_PROJECT_ID
GCP_REGION=YOUR_GCP_REGION
GCP_RUN_SERVICE=YOUR_GCP_RUN_SERVICE

# =============================================================================
# 場景 C 必填區（本機 n8n 直連遠端 Supabase）
# =============================================================================
# 與場景 B 相同：填 GCP 後執行 pull-secrets。不要跑 sync-from-cloud。

# =============================================================================
# 由指令或腳本產生
# =============================================================================
# 由 pull-secrets 寫入，請勿手填
N8N_ENCRYPTION_KEY=
CLOUD_DB_POSTGRESDB_HOST=
CLOUD_DB_POSTGRESDB_PORT=5432
CLOUD_DB_POSTGRESDB_DATABASE=postgres
CLOUD_DB_POSTGRESDB_USER=
CLOUD_DB_POSTGRESDB_SCHEMA=public
CLOUD_DB_POSTGRESDB_PASSWORD=

# 由啟動腳本寫入，請勿手改
N8N_LOCAL_BOOTSTRAPPED=
