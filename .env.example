# =============================================================================
# 部署場景與對外通道
# =============================================================================
# A：空白本機 Postgres
# B：複製 Cloud Run 資料到本機 Postgres
# C：直連遠端 Supabase
N8N_SCENARIO=A

# true：對外 Webhook / OAuth；false：僅本機編輯
ENABLE_NGROK=false

# =============================================================================
# 必填區（場景 A / B 要本機 Postgres；場景 C 可略過密碼）
# =============================================================================
# 不要填雲端資料庫帳密。
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# ENABLE_NGROK=true 時必填。網域只要主機名，不要加 https://
NGROK_AUTHTOKEN=YOUR_NGROK_AUTHTOKEN
NGROK_DOMAIN=YOUR_NGROK_DOMAIN

# 通常不用改
N8N_IMAGE=n8nio/n8n:2.36.8
# 必須與 N8N_IMAGE 同一版號
N8N_RUNNERS_IMAGE=n8nio/runners:2.36.8

# true：啟用 Code 節點 task runners（會建立自訂映像）；false：不建立、不啟動 runners
# 首次啟動若留空，啟動腳本會詢問。
ENABLE_N8N_RUNNERS=
# 由啟動腳本依 ENABLE_N8N_RUNNERS 寫入：啟用時必須是 external，停用時才是 internal。
# 若手改 ENABLE_N8N_RUNNERS=true，請一併改成 N8N_RUNNERS_MODE=external。
N8N_RUNNERS_MODE=internal
N8N_NATIVE_PYTHON_RUNNER=false
# Code 節點（JavaScript）允許 require 的內建 / 外部套件（逗號分隔）。僅 ENABLE_N8N_RUNNERS=true 時會裝進映像。
# 改過套件清單後，請再執行一次啟動腳本（會重建 runners 映像）。
NODE_FUNCTION_ALLOW_BUILTIN=crypto
NODE_FUNCTION_ALLOW_EXTERNAL=pdf-lib
# Code 節點（Python）標準庫 / 第三方套件允許清單。
# N8N_RUNNERS_PY_PACKAGES：要 pip 安裝的套件名（例如 pymupdf）。
# N8N_RUNNERS_EXTERNAL_ALLOW：Code 節點可 import 的模組名（pymupdf 的 import 名稱是 fitz）。
N8N_RUNNERS_STDLIB_ALLOW='*'
N8N_RUNNERS_PY_PACKAGES=pymupdf
N8N_RUNNERS_EXTERNAL_ALLOW=pymupdf,fitz
N8N_RUNNERS_ALLOW_TRANSITIVE_IMPORTS=true

# 由啟動腳本產生，請勿手填
N8N_RUNNERS_AUTH_TOKEN=
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Taipei

# =============================================================================
# 場景 A 必填區（以新的環境開始）
# =============================================================================
# 沒有額外必填。不必填 encryption key 與 CLOUD_DB_*，也不需要 gcloud。

# =============================================================================
# 場景 B 必填區（繼承 Google Cloud Run 的資料到本機 Postgres）
# =============================================================================
# 先 gcloud auth login，再執行 pull-secrets。請勿手填密鑰區。
GCP_PROJECT=YOUR_GCP_PROJECT_ID
GCP_REGION=YOUR_GCP_REGION
GCP_RUN_SERVICE=YOUR_GCP_RUN_SERVICE

# =============================================================================
# 場景 C 必填區（本機 n8n 直連遠端 Supabase）
# =============================================================================
# 與場景 B 相同：填 GCP 後執行 pull-secrets。不要跑 sync-from-cloud。

# =============================================================================
# 由指令或腳本產生
# =============================================================================
# 由 pull-secrets 寫入，請勿手填
N8N_ENCRYPTION_KEY=
CLOUD_DB_POSTGRESDB_HOST=
CLOUD_DB_POSTGRESDB_PORT=5432
CLOUD_DB_POSTGRESDB_DATABASE=postgres
CLOUD_DB_POSTGRESDB_USER=
CLOUD_DB_POSTGRESDB_SCHEMA=public
CLOUD_DB_POSTGRESDB_PASSWORD=

# 由啟動腳本寫入，請勿手改
N8N_LOCAL_BOOTSTRAPPED=
