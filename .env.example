# =============================================================================
# 必填區（場景 A / B 要本機 Postgres；場景 C 可略過密碼）
# =============================================================================
# 本機 Postgres，不要填 Cloud Run / Supabase 的帳密。
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD # 自行設定

# 使用 `docker compose --profile tunnel up -d` 時必填；只開本機編輯器可先留空。
# 只填網域（不要加 https://）。compose 會組成 https://<NGROK_DOMAIN>/ 當 webhook。
NGROK_AUTHTOKEN=YOUR_NGROK_AUTHTOKEN # 透過 ngrok 官方網站註冊取得
NGROK_DOMAIN=YOUR_NGROK_DOMAIN # 透過 ngrok 官方網站註冊取得

# 已有預設值，通常不用改。有填 NGROK_DOMAIN 時，compose 會把 OAuth / webhook 對外網址改成 https://<NGROK_DOMAIN>。
N8N_IMAGE=n8nio/n8n:2.36.8
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Taipei

# =============================================================================
# 場景 A 必填區（以新的環境開始）
# =============================================================================
# 沒有額外必填。不必填 N8N_ENCRYPTION_KEY 與 CLOUD_DB_*，
# 也不需要 gcloud。n8n 會自己產生本機 encryption key。

# =============================================================================
# 場景 B 必填區（繼承 Google Cloud Run 的資料到本機 Postgres）
# =============================================================================
# 給 ./scripts/pull-secrets.sh 用。請先完成 gcloud auth login，
# 確認專案後再跑腳本。不要在下面「勿動」區手填密鑰或雲端密碼。
GCP_PROJECT=YOUR_GCP_PROJECT_ID
GCP_REGION=YOUR_GCP_REGION
GCP_RUN_SERVICE=YOUR_GCP_RUN_SERVICE

# =============================================================================
# 場景 C 必填區（本機 n8n 直連遠端 Supabase）
# =============================================================================
# 與場景 B 相同：先跑 ./scripts/pull-secrets.sh，讓勿動區寫入
# N8N_ENCRYPTION_KEY 與 CLOUD_DB_*。不要跑 sync-from-cloud.sh。
# 或者直接修改 "由指令或腳本產生" 區的密鑰。

# =============================================================================
# 由指令或腳本產生
# =============================================================================
# 盡可能透過 ./scripts/pull-secrets.sh 寫入，避免人為密鑰輸入錯誤導致無法連線。
N8N_ENCRYPTION_KEY=
CLOUD_DB_POSTGRESDB_HOST=
CLOUD_DB_POSTGRESDB_PORT=5432
CLOUD_DB_POSTGRESDB_DATABASE=postgres
CLOUD_DB_POSTGRESDB_USER=
CLOUD_DB_POSTGRESDB_SCHEMA=public
CLOUD_DB_POSTGRESDB_PASSWORD=
